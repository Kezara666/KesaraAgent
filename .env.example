# Copy to .env (gitignored). Never commit real values.
ASPNETCORE_ENVIRONMENT=Development

# LLM providers (free tiers). Keys are read by the host, never logged.
NIM_API_KEY=
# A model id from NVIDIA NIM (used by scripts/dev/run-local-api.ps1)
NIM_MODEL=
OPENROUTER_API_KEY=
# A free model id from your provider's list (used by scripts/dev/run-local-api.ps1)
AGENT_MODEL=

# Database (local Docker or Neon free tier)
DATABASE_CONNECTION=Host=localhost;Port=5432;Database=agent;Username=agent;Password=change-me

# API access token hash (store a hash, not the raw token)
API_TOKEN_HASH=

# Notifications (ntfy topic name)
NTFY_TOPIC=
